# Malama IT – Apache-Empfehlungen (falls der Hoster Apache nutzt)
# Ohne Wirkung auf Nginx/IIS – dann entsprechende Header dort setzen.

Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS erzwingen (aktivieren, wenn SSL aktiv und kein Proxy-Konflikt)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Lange Cache-Zeit für Fonts und statische Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 14 days"
  ExpiresByType image/png "access plus 14 days"
  ExpiresByType image/webp "access plus 14 days"
</IfModule>
